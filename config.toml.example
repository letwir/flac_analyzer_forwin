[database]
# PostgreSQL データベースの接続 URL
url = "postgres://username:password@localhost:5432/flac_analyzer_db"
# PostgreSQL 接続およびクエリ実行タイムアウト (秒, デフォルト: 20秒)
db_timeout_sec = 20

[orchestrator]
# ワーカープロセス数 (0 の場合は CPU/RAM リソースに基づく自動算出)
num_workers = 0

# メモリ防御・リソース割り当て制御パラメータ
max_ram_ratio = 0.625            # システム最大使用メモリ割合 (例: 62.5%)
cpu_worker_ratio = 0.80          # CPUコア数に対する最大ワーカー割り当て割合
estimated_worker_ram_gb = 3.5    # ワーカー1基あたりの想定メモリ使用量 (GB: 長尺トラック対応推奨値)
min_avail_ram_gb = 3.5           # 最低保証空きメモリ容量 (GB)
min_avail_disk_gb = 5.0          # 最低保証空きディスク容量 (GB: queue/temp ドライブ空き容量監視)
tagger_disk_margin_ratio = 1.5   # FLAC タグ書き込み時の一時ファイル作成用空き容量マージン倍率 (デフォルト: 1.5)

# Demucs ONNX 推論の同時実行数制限 (GPU/VRAM 保護のため通常 1)
demucs_concurrent_limit = 1
# Demucs is deliberately isolated to one GPU daemon; feature-GPU has its own pool.
demucs_daemon_capacity = 1
# GPU & Dedicated VRAM 防御・スロット制御パラメータ
# dedicated_vram_total_gb: 専用ビデオメモリ (Dedicated VRAM) 総容量の明示的指定 (GB, オプション)
# WMI AdapterRAM の 32-bit 上限やマルチアダプタ誤報を回避し、GPU VRAM 判定を健全化します
# 有効な有限・正・上限有界値 (例: 16.0) を指定した場合のみ専用容量として採用されます。
# 未設定 (0) または無効値/使用量未満の過小値の場合は unknown として安全側 (NOGO/シングルスロット維持) に扱われます
dedicated_vram_total_gb = 16.0
max_gpu_utilization_ratio = 0.85     # GPU 負荷率上限 (例: 0.85 = 85%)
min_avail_vram_gb = 0.5              # 最低保証専用 VRAM 空き容量 (GB)
estimated_demucs_vram_gb = 1.0       # Demucs 推論あたりの想定 VRAM 使用量 (GB)
enable_gpu_throttle = true           # GPU 負荷・VRAM 不足時のディスパッチ待機 (Gatekeeper) 有効化
# 共有メモリ (SHM) 割り当てインターバル (秒: ゼロで即時ディスパッチ)
shm_allocation_delay_sec = 0
# 共有メモリ (SHM) の FLAC ファイルに対する PCM 展開マージン比率 (デフォルト: 3.5)
shm_expansion_ratio = 3.5
# 共有メモリ確保失敗時の最大リトライ回数およびバックオフスリープ秒数
shm_retry_count = 5
shm_retry_delay_sec = 8

# 解析中間 JSON の出力キューディレクトリ (相対パスまたは絶対パス)
queue_dir = "./queue"
# テスト用 FLAC 格納ディレクトリ
test_flac_dir = "./testFLAC"

# mix波形MD5ハッシュによる登録済みトラックの事前重複判定・解析バイパス
skip_dup_by_hash = true

# Windows 共有メモリ (SHM) の物理 RAM 固着化 (VirtualLock / Pinning) 有効化
enable_virtual_lock = true
min_working_set_mb = 512          # 起動時初期最小ワーキングセット (MB, デフォルト: 512)
max_working_set_mb = 16384        # 起動時初期最大ワーキングセット (MB, デフォルト: システムRAMの75%または16384)

# Gatekeeper (メモリ事前判定) の NOGO 時リトライ待機秒数 (デフォルト: 20秒)
gatekeeper_retry_delay_sec = 20
gatekeeper_max_retries = 5       # NOGOが連続したタスクをFAILED_MAYBE_RETRYへ退避する回数

# 物理 RAM 安全圏超過時の SSD/TMP ディスク退避モード (Disk Mode Fallback)
enable_disk_mode_fallback = true      # 推定 RAM が安全閾値超過時に SSD 一時ファイル経由へ自動退避 (デフォルト: true)
disk_mode_ram_threshold_ratio = 0.8  # 空き RAM に対する Disk Mode 切替閾値割合 (デフォルト: 0.8 = 80%)

# 設定ファイル (config.toml) の変更検知・ホットリロード監視間隔 (秒, デフォルト: 600秒 = 10分)
config_watch_interval_sec = 600

# PostgreSQL 送信失敗時 DLQ (send_failed.db) の自動再送・リカバリ設定
enable_dlq_retry = true
dlq_retry_interval_sec = 600          # DLQ 定期自動リトライ間隔 (秒, デフォルト: 600秒 = 10分, 0 で定期実行無効化・起動時のみ)

[python_env]
# Python シングルスレッド化および環境変数設定 (CPU スレッド競合・オーバーヘッドの防止)
omp_num_threads = "1"
openblas_num_threads = "1"
mkl_num_threads = "1"
numexpr_num_threads = "1"
veclib_maximum_threads = "1"
hf_hub_offline = "1"
pythonutf8 = "1"
pythonioencoding = "utf-8"
# メモリエラー(ArrayMemoryError)発生時のリトライ回数およびスリープ秒数
memory_retry_count = "3"
memory_retry_delay_sec = "6"

[models]
# ONNX / ステム分離・特徴量抽出モデル用パラメータ
graph_optimization_level = "basic"    # ONNX グラフ最適化 (basic / all / disable)
intra_op_num_threads = 1
inter_op_num_threads = 1
patch_size = 128
patch_hop = 62
n_fft = 512
hop_length = 256
n_mels = 96
sr = 44100
resample_sr = 16000
